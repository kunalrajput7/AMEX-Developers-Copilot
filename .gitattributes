# Normalise line endings so the repo stays identical across Windows, macOS and
# Linux. Without this, a checkout on another OS shows every file as modified.
* text=auto eol=lf

# Binary-ish files git should never try to convert
*.png binary
*.jpg binary
*.ico binary
*.pdf binary

# Generated files: collapse them in pull-request diffs
package-lock.json linguist-generated=true
*.jsonl linguist-generated=true
