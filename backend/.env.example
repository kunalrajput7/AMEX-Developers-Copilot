# Copy this file to `.env` (same folder) and fill in the values below.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Azure AI Foundry — the ONLY vendor dependency in this project.
#
# You need THREE MODEL DEPLOYMENTS (not three agents — the agent is our own
# LangGraph code running locally, it just calls these models):
#
#   1. a chat model       e.g. claude-sonnet-4-6      writes the answers
#   2. an embedding model e.g. text-embedding-3-large builds the knowledge base
#   3. a judge model      e.g. gpt-4.1                grades answers in eval
#
# The judge is deliberately a DIFFERENT FAMILY from the chat model. A model
# grading its own output scores itself generously and is blind in the same
# places; a sibling model shares those blind spots. Independence is the point.
#
# All three live on one Foundry resource but across two surfaces speaking two
# protocols, so the code has one client per role.
# ---------------------------------------------------------------------------

# --- Chat model: Anthropic surface -----------------------------------------
# Foundry serves Claude at <resource>.services.ai.azure.com/anthropic and
# speaks the Anthropic protocol, so this uses the anthropic SDK.
ANTHROPIC_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com/anthropic
ANTHROPIC_FOUNDRY_API_KEY=your-key

# The *deployment name* you gave the model in Foundry
# (the deployment name, not the model name — they are often different).
ANTHROPIC_CHAT_DEPLOYMENT=claude-sonnet-4-6

# --- Embedding and judge models: Azure OpenAI surface ----------------------
# Same resource, no /anthropic suffix, and it speaks the OpenAI protocol.
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# The evaluation judge. Leave blank and evaluation still runs, but the
# answering model grades itself and the scores read higher than they should —
# `scripts/check_models.py` warns when that is the case.
AZURE_OPENAI_JUDGE_DEPLOYMENT=gpt-4.1

# LEGACY. A second Claude deployment as judge. Superseded by the line above:
# a same-family judge removes self-grading but not the shared blind spots.
ANTHROPIC_JUDGE_DEPLOYMENT=

# NOTE ON DIMENSIONS: text-embedding-3-large is natively 3072-dimensional, but
# pgvector's HNSW index supports at most 2000. The v3 embedding models accept a
# `dimensions` parameter, so we request 1536 — keeping the index usable while
# still beating text-embedding-3-small at the same size. If you change this,
# change VECTOR(n) in app/db/schema.sql to match and re-ingest.

# ---------------------------------------------------------------------------
# Database — local Postgres + pgvector from docker-compose.
# To point at a hosted Postgres instead, change only this line.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/copilot

# ---------------------------------------------------------------------------
# GitHub — optional. Without a token the API allows 60 requests/hour, which is
# not enough to fetch issues. A fine-grained token with no extra permissions
# is sufficient; reading public repos needs no scopes at all.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Agent budget — caps how many tool calls the agent may make per question.
# ---------------------------------------------------------------------------
MAX_TOOL_CALLS=5

# ---------------------------------------------------------------------------
# Tuning. Every one of these has a working default in app/config.py, so leave
# them out unless you have a reason. Listed here so you don't have to read the
# source to discover they exist.
# ---------------------------------------------------------------------------

# Upper bound on a single answer. Answers are short and grounded, so the
# default is generous rather than tight.
# CHAT_MAX_TOKENS=2000

# Must match VECTOR(n) in app/db/schema.sql. Changing it means re-ingesting,
# and anything above 2000 breaks pgvector's HNSW index.
# EMBEDDING_DIMENSIONS=1536

# List prices used only for the estimated cost on each request log line. They
# ignore prompt caching and any negotiated discount — good for spotting a
# question that costs ten times the others, not for reconciling an invoice.
# COST_PER_MILLION_INPUT_TOKENS=3.00
# COST_PER_MILLION_OUTPUT_TOKENS=15.00
# COST_PER_MILLION_EMBEDDING_TOKENS=0.13
